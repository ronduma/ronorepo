{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start dev containers (Taskfile)",
      "type": "shell",
      "command": "task up",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "stop dev containers (Taskfile)",
      "type": "shell",
      "command": "task down",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
